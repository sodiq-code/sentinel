# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but always track the .env.example template
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log

server.log

# Skills directory (Z.ai scaffold runtime, not the Sentinel skill/)
/skills/

# Sentinel runtime artefacts
/examples/trace/*.log
/prisma/migrations/dev/

# zscripts (internal scaffold, not part of Sentinel)
/.zscripts/

# SQLite db is regenerable via `bun run db:push`; never commit it
/db/*.db
/db/*.db-journal

# User reference inputs (hackathon strategy PDF, plan text) — not project code
/upload/

# Scaffold download dir
/download/

# Agent tool-results (transient read outputs, not project code)
/tool-results/