# =============================================================================
# Sentinel — environment configuration
# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.
# =============================================================================

# ---- DataHub connection -----------------------------------------------------
# Leave DATAHUB_GMS_URL empty to run in DEMO mode (uses seeded Prisma fixtures).
# Set all three to run in LIVE mode against a real DataHub deployment.
DATAHUB_GMS_URL=
DATAHUB_TOKEN=
DATAHUB_MODE=demo                          # demo | live

# ---- LLM ------------------------------------------------------------------
# Three interchangeable OpenAI-compatible providers. The orchestrator is
# provider-agnostic — the ReAct loop calls the same chat/completions surface
# either way. (PDF §10.2: one provider, temperature 0, deterministic.)
#
#   LLM_PROVIDER=groq     — direct Groq API (DEFAULT; free tier, real outbound
#                           LLM calls, tool-calling support). Get a key at
#                           console.groq.com/keys.
#   LLM_PROVIDER=zai      — z-ai-web-dev-sdk gateway (only works inside the
#                           original build environment)
#   LLM_PROVIDER=nvidia   — direct NVIDIA NIM (needs a valid NVIDIA_API_KEY +
#                           outbound to integrate.api.nvidia.com)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile         # primary model (provider=groq)
LLM_FALLBACK_MODEL=llama-3.1-8b-instant   # swapped in if the primary 429/5xxs
LLM_TEMPERATURE=0                         # PDF §10.2: determinism for the demo
LLM_MAX_TOKENS=1500

# ---- Groq (default provider) ----------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Phase 3 resilience: rate-limit + circuit-breaker + failover ----------
# Pace limiter (per-provider token bucket). Default 15s keeps a multi-step
# ReAct loop under Groq's free-tier TPM cap (12K TPM on llama-3.3-70b) — each
# step's prompt (system prompt + tool schemas + growing scratchpad) runs
# several thousand tokens, so back-to-back calls blow through the per-minute
# budget fast. Raise this if you're on a paid Groq tier, or lower it for
# faster local iteration at the risk of more 429s (the circuit breaker still
# degrades gracefully either way). 1 token / LLM_RATE_LIMIT_MS.
LLM_RATE_LIMIT_MS=15000
# 429-specific backoff curve (longer + jittered). 5s, 10s, 20s by default.
LLM_RATE_LIMIT_BACKOFF_MS=5000
LLM_RATE_LIMIT_BACKOFF_MAX_MS=20000
# Circuit breaker — opens after N consecutive 429/5xx, stays open for the
# cooldown. While open, calls throw CircuitOpenError immediately (no retry
# burn) so the orchestrator's fallback post-mortem path runs gracefully.
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_MS=60000
# Failover — when LLM_PROVIDER=zai AND a NVIDIA_API_KEY is present AND this is
# 'true' (default), the dormant NvidiaNimLlmClient takes over when z-ai's
# circuit is open. In local dev the NVIDIA key is dead (401 on inference), so
# the failover surfaces a clear CircuitOpenError instead of masking it.
# Set to false to keep z-ai-only behaviour (no failover attempt).
LLM_FAILOVER_ENABLED=true

# ---- NVIDIA NIM (alternative provider; used when LLM_PROVIDER=nvidia) -----
# Primary: NVIDIA's flagship reasoning model with parallel tool-calling.
# Fallback: OpenAI GPT-OSS 120B (NVIDIA-hosted), used if the primary 429s or
# times out during the demo (PDF §13.5 risk register). Also serves as the
# dormant failover target when LLM_PROVIDER=zai (see LLM_FAILOVER_ENABLED).
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- GitHub connector (Phase 3) -------------------------------------------
# A throwaway PAT scoped to ONE demo repo with `issues:write` +
# `pull_requests:write` only. We never ask for `repo:admin` or `contents:write`
# — Sentinel opens PRs but NEVER merges them, and never pushes branches.
# When SENTINEL_DRY_RUN=true (default), the connector writes a JSONL record to
# `examples/trace/github-actions.log` instead of calling GitHub — so the
# demo runs without a token. Set a token + SENTINEL_DRY_RUN=false to file
# real issues + PRs in the demo repo. (PDF §9.3.5 no-merge policy)
GITHUB_TOKEN=
GITHUB_DEMO_REPO=                            # e.g. sodiq-code/sentinel-demo-pipeline

# ---- Slack connector (Phase 3) --------------------------------------------
# A throwaway bot token scoped to ONE channel (chat:write is sufficient — the
# bot does NOT need channels:read). When SENTINEL_DRY_RUN=true, the connector
# writes a JSONL record to `examples/trace/slack-posts.log` instead of
# posting to Slack — so the demo runs without a token. Set a token +
# SENTINEL_DRY_RUN=false to post real triage cards to the demo channel.
SLACK_BOT_TOKEN=
SLACK_DEMO_CHANNEL=C0BL9CQ4D5G

# ---- Sentinel runtime ------------------------------------------------------
# SENTINEL_DRY_RUN=true (default): all action.* tool calls write to the trace
# JSONL log instead of calling GitHub/Slack. Flip to false to file real issues
# + post real Slack messages. The guardrail still enforces PII refusal +
# no-merge + approval gates regardless of this flag. (PDF §11.3 contingency)
SENTINEL_DRY_RUN=true
SENTINEL_LOG_LEVEL=info                     # trace | debug | info | warn | error

# ---- Database (Prisma + SQLite) -------------------------------------------
# Already set in this Next.js scaffold; keep the file: prefix for SQLite.
DATABASE_URL=file:/home/z/my-project/db/custom.db
