# =============================================================================
# Sentinel — environment configuration
# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.
# =============================================================================

# ---- DataHub connection -----------------------------------------------------
# Leave DATAHUB_GMS_URL empty to run in DEMO mode (uses seeded Prisma fixtures).
# Set all three to run in LIVE mode against a real DataHub deployment.
DATAHUB_GMS_URL=
DATAHUB_TOKEN=
DATAHUB_MODE=demo                          # demo | live

# ---- LLM ------------------------------------------------------------------
# Multi-provider stack with failover. The orchestrator is provider-agnostic:
# every provider exposes the same OpenAI-compatible chat/completions surface,
# so the ReAct loop runs identically on any provider. Temperature 0 throughout
# for deterministic demo runs.
#
#   LLM_PROVIDER=gemini    — Google Gemini 2.0 Flash (PRODUCTION PRIMARY).
#                           Free forever, 1M tokens-per-minute, 1M token
#                           context window, native function-calling. Get a key
#                           at https://aistudio.google.com/apikey (no credit
#                           card). Classic keys start with `AIza`; newer Cloud
#                           Console keys use the `AQ.` prefix — both accepted.
#   LLM_PROVIDER=groq      — Groq API (fast inference, free tier).
#
# Failover: when the primary's circuit opens (e.g. the daily free-tier quota
# is exhausted), the FailoverLlmClient routes ALL LLM calls to the fallback
# provider — so the ReAct loop ALWAYS completes.
#   LLM_FALLBACK_PROVIDER=groq    — production default: Groq free tier.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
# Per-provider default model when LLM_MODEL is unset (auto-picked per provider).
# Leave LLM_MODEL empty to use the per-provider default.
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0                         # determinism for the demo
LLM_MAX_TOKENS=1500

# ---- Google Gemini 2.0 Flash (production primary — free forever) ---------
# Get a free key at https://aistudio.google.com/apikey (no credit card).
# 1M tokens-per-minute, 1M token context, native function-calling.
# OpenAI-compatible endpoint: generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# ---- Groq (fallback provider) ---------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Resilience: rate-limit + circuit-breaker + failover ------------------
# Pace limiter (per-provider token bucket). Default 15s keeps a multi-step
# ReAct loop under the free-tier TPM cap — each step's prompt (system prompt +
# tool schemas + growing scratchpad) runs several thousand tokens, so back-to-
# back calls can blow through the per-minute budget. Raise this on a paid
# tier, or lower it for faster local iteration. 1 token / LLM_RATE_LIMIT_MS.
LLM_RATE_LIMIT_MS=15000
# 429-specific backoff curve (longer + jittered). 5s, 10s, 20s by default.
LLM_RATE_LIMIT_BACKOFF_MS=5000
LLM_RATE_LIMIT_BACKOFF_MAX_MS=20000
# Circuit breaker — opens after N consecutive 429/5xx, stays open for the
# cooldown. While open, calls throw CircuitOpenError immediately (no retry
# burn) so the orchestrator's fallback post-mortem path runs gracefully.
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_MS=60000
# Failover toggle — when 'true' (default) and the primary's circuit is open,
# LLM calls route to LLM_FALLBACK_PROVIDER so the agent keeps running.
LLM_FAILOVER_ENABLED=true

# ---- GitHub connector -----------------------------------------------------
# A throwaway PAT scoped to ONE demo repo with `issues:write` +
# `pull_requests:write` only. We never ask for `repo:admin` or `contents:write`
# — Sentinel opens PRs but NEVER merges them, and never pushes branches.
# When SENTINEL_DRY_RUN=true (default), the connector writes a JSONL record to
# `examples/trace/github-actions.log` instead of calling GitHub — so the
# demo runs without a token. Set a token + SENTINEL_DRY_RUN=false to file
# real issues + PRs in the demo repo. (No-merge policy.)
GITHUB_TOKEN=
GITHUB_DEMO_REPO=                            # e.g. sodiq-code/sentinel-demo-pipeline
# Idempotency (search-before-create): when an OPEN issue with the SAME title
# already exists in the demo repo, Sentinel appends the new context as a
# COMMENT on that issue instead of opening a duplicate. This is the
# production-grade behaviour expected of an autonomous agent — repeated
# signals for the same breach surface as a threaded timeline, not as
# duplicate tickets. Set to `false` to always open a new issue.
SENTINEL_GITHUB_DEDUP=true

# ---- Slack connector ------------------------------------------------------
# A throwaway bot token scoped to ONE channel (chat:write is sufficient — the
# bot does NOT need channels:read). When SENTINEL_DRY_RUN=true, the connector
# writes a JSONL record to `examples/trace/slack-posts.log` instead of
# posting to Slack — so the demo runs without a token. Set a token +
# SENTINEL_DRY_RUN=false to post real triage cards to the demo channel.
SLACK_BOT_TOKEN=
SLACK_DEMO_CHANNEL=C0BL9CQ4D5G

# ---- Sentinel runtime ------------------------------------------------------
# SENTINEL_DRY_RUN=true (default): all action.* tool calls write to the trace
# JSONL log instead of calling GitHub/Slack. Flip to false to file real issues
# + post real Slack messages. The guardrail still enforces PII refusal +
# no-merge + approval gates regardless of this flag.
SENTINEL_DRY_RUN=true
SENTINEL_LOG_LEVEL=info                     # trace | debug | info | warn | error

# ---- Database (Prisma + SQLite) -------------------------------------------
# Local SQLite for dev; Turso libSQL in production. Keep the file: prefix for
# local SQLite.
DATABASE_URL=file:/home/z/my-project/db/custom.db
